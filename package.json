{
  "name": "benchline-stats",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:psql": "docker compose exec postgres sh -c 'exec psql -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\"'",
    "db:generate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server node_modules/drizzle-kit/bin.cjs migrate",
    "auth:schema": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server node_modules/auth/dist/index.mjs generate --config src/server/auth/auth.ts --output src/server/db/auth_schema.ts --yes",
    "auth:bootstrap-admin": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server scripts/bootstrap-admin.ts",
    "auth:create-user": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server scripts/create-user.ts",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.8",
    "@mantine/core": "9.7.3",
    "@mantine/dates": "9.7.3",
    "@mantine/hooks": "9.7.3",
    "@tanstack/react-query": "5.104.3",
    "better-auth": "1.7.8",
    "dayjs": "1.11.23",
    "dexie": "4.4.6",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.59.0",
    "next": "16.4.0",
    "next-intl": "4.14.9",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@clack/prompts": "1.6.0",
    "@serwist/turbopack": "9.5.13",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "auth": "1.7.8",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.0",
    "prettier": "^3.0.0",
    "serwist": "9.5.13",
    "typescript": "~5.9.3"
  }
}
