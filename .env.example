# Local development only. Keep DATABASE_URL aligned with the PostgreSQL values.
POSTGRES_DB=benchline_stats
POSTGRES_USER=benchline
POSTGRES_PASSWORD=benchline_local
POSTGRES_PORT=5432

DATABASE_URL=postgresql://benchline:benchline_local@127.0.0.1:5432/benchline_stats

# Generate a random secret before running authentication. Never commit real values.
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
