# Copy outside the repository before editing. Never use the placeholder secrets.
# Compose reads this with --env-file; it passes only each service's mapped values.
BENCHLINE_IMAGE=benchline-stats:sha-REPLACE_WITH_FULL_COMMIT

POSTGRES_DB=benchline_stats
POSTGRES_ADMIN_PASSWORD=replace-with-a-random-maintenance-password
BENCHLINE_DB_USER=benchline
BENCHLINE_DB_PASSWORD=replace-with-a-separate-random-application-password

# Compose expands the application password. Hex secrets avoid URL-encoding issues.
# Keep the username and database name aligned with the values above.
DATABASE_URL=postgresql://${BENCHLINE_DB_USER}:${BENCHLINE_DB_PASSWORD}@postgres:5432/${POSTGRES_DB}

BETTER_AUTH_SECRET=replace-with-a-separate-random-secret-at-least-32-characters
BETTER_AUTH_URL=https://benchline.filipemendes.dev
